// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    // Custom agent: use our OpenCode v2 install (the Zed registry entry is v1
    // and fails against the v2 database). opencode resolves via shell PATH.
    "opencode": {
      "default_config_options": {
        "model": "opencode-go/deepseek-v4-pro"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark Soft",
  },
  // Remote development: ghost (https://zed.dev/docs/remote-development)
  "ssh_connections": [
    {
      "host": "ghost",
      "projects": [{ "paths": ["~/Developer/environment"] }],
    },
  ],
}
