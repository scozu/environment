// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview": {
    "font_family": "Inter"
  },
  "ui_font_family": "Inter",
  "buffer_font_family": "Lilex",
  "agent_servers": {
    // Custom agent: use our OpenCode v2 install (the Zed registry entry is v1
    // and fails against the v2 database). opencode resolves via shell PATH.
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6.1-sol"
      },
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "model": "opencode-go/deepseek-v4-pro"
      },
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  },
  "vim_mode": true,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Pierre Dark Soft",
  },
  // Remote development: ghost (https://zed.dev/docs/remote-development)
  "ssh_connections": [
    {
      "host": "ghost",
      "args": [],
      "projects": [
        { "paths": ["/Users/scozu/Developer/studiopendleton/proofer"] },
        { "paths": ["~/Developer/environment"] },
      ],
    },
  ],
}
