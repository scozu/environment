{
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "autoupdate": true,
  // Opus on the Claude subscription leads and reviews. Everything else runs on
  // the OpenCode Go subscription to save Opus usage. See agents/lead.md.
  "model": "claude-agent/opus",
  "default_agent": "lead",
  "agents": {
    "compaction": { "model": "opencode-go/deepseek-v4.1-flash" },
    "general": { "model": "opencode-go/deepseek-v4.1-flash" },
    "explore": { "model": "opencode-go/deepseek-v4.1-flash" },
  },
}
