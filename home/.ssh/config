# Machine-specific overrides live in ~/.ssh/config.local (untracked, gitignored).
# ssh_config uses the FIRST value obtained, so this include at the top lets local values win.
Include ~/.ssh/config.local

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes

Host ghost
    HostName ghost.tail483f5.ts.net
    User scozu
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    AddKeysToAgent yes
    UseKeychain yes
    ServerAliveInterval 30
    ServerAliveCountMax 6
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m
