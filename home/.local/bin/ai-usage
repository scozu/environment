#!/bin/sh
# One line of Claude plan and OpenCode Go usage, plus a subagent-tier advice level.
# Logs each run to ~/.local/state/ai-usage.log (machine-local, never committed).
# Always exits 0; a source that fails prints as "unknown".

LOG="${AI_USAGE_LOG:-$HOME/.local/state/ai-usage.log}"
# claude finds its subscription login through USER; a shell without it (launchd, env -i) gets the cost summary instead of /usage.
USER=${USER:-$(id -un 2>/dev/null)}
export USER
now=$(date +%s)

# macOS has no timeout(1); perl's alarm works on macOS and Linux.
limit() { secs=$1; shift; perl -e 'alarm shift; exec @ARGV or exit 127' "$secs" "$@"; }

# pace <reset epoch> <window seconds>: percent of the window already elapsed.
pace() {
  p=$(( (now - ($1 - $2)) * 100 / $2 ))
  [ "$p" -lt 0 ] && p=0
  [ "$p" -gt 100 ] && p=100
  echo "$p"
}

# to_epoch <Mon> <day> <h:mmam|pm> <IANA zone>
to_epoch() {
  year=$(date +%Y)
  e=$(TZ=$4 date -j -f "%b %d %Y %I:%M%p" "$1 $2 $year $3" +%s 2>/dev/null) ||
    e=$(TZ=$4 date -d "$1 $2 $year $3" +%s 2>/dev/null) || return 1
  if [ "$e" -lt $((now - 2592000)) ]; then
    year=$((year + 1))
    e=$(TZ=$4 date -j -f "%b %d %Y %I:%M%p" "$1 $2 $year $3" +%s 2>/dev/null) ||
      e=$(TZ=$4 date -d "$1 $2 $year $3" +%s 2>/dev/null) || return 1
  fi
  echo "$e"
}

# window_fields <claude /usage text> <label regex> <window seconds>
# prints "used pace" or nothing when the line is missing or unparseable.
window_fields() {
  line=$(printf '%s\n' "$1" | sed -n -E "s/^.*$2:[^0-9]*([0-9]{1,3})%.*resets ([A-Za-z]{3}) ([0-9]{1,2}) at ([0-9]{1,2}(:[0-9]{2})?[ap]m) \(([^)]+)\).*$/\1|\3|\4|\2|\6/p" | head -1)
  [ -n "$line" ] || return 0
  used=${line%%|*}; rest=${line#*|}
  day=${rest%%|*}; rest=${rest#*|}
  tm=${rest%%|*}; rest=${rest#*|}
  mon=${rest%%|*}; zone=${rest#*|}
  case $tm in *:*) ;; *) tm=$(printf '%s' "$tm" | sed -E 's/([ap]m)$/:00\1/') ;; esac
  e=$(to_epoch "$mon" "$day" "$tm" "$zone") || return 0
  echo "$used $(pace "$e" "$3")"
}

claude_text=$(limit 12 claude -p "/usage" 2>/dev/null </dev/null)
sess=$(window_fields "$claude_text" "Current session" 18000)
week=$(window_fields "$claude_text" "Current week \(all models\)" 604800)

go_json=$(limit 6 opencode api get /api/experimental/usage/limits 2>/dev/null)
go_window() {
  obj=$(printf '%s' "$go_json" | grep -o "\"$1\":{[^}]*}" | head -1)
  [ -n "$obj" ] || return 0
  pct=$(printf '%s' "$obj" | sed -n -E 's/.*"percent":([0-9]+).*/\1/p')
  lim=$(printf '%s' "$obj" | sed -n -E 's/.*"limited":([a-z]+).*/\1/p')
  [ -n "$pct" ] && [ -n "$lim" ] || return 0
  reset=$(printf '%s' "$obj" | sed -n -E 's/.*"resetsAt":([0-9]+).*/\1/p')
  echo "$pct $lim $reset"
}
rolling=$(go_window rolling)
weekly=$(go_window weekly)
monthly=$(go_window monthly)

go_tight=
go_part=unknown
if [ -n "$rolling" ] && [ -n "$weekly" ] && [ -n "$monthly" ]; then
  r_pct=${rolling%% *}; r_rest=${rolling#* }; r_lim=${r_rest%% *}
  w_pct=${weekly%% *}; w_rest=${weekly#* }; w_lim=${w_rest%% *}; w_reset=${w_rest#* }
  m_pct=${monthly%% *}; m_rest=${monthly#* }; m_lim=${m_rest%% *}; m_reset=${m_rest#* }
  go_part="go 5h ${r_pct}% week ${w_pct}%"
  go_wk_pace=
  if [ -n "$w_reset" ]; then
    go_wk_pace=$(pace $((w_reset / 1000)) 604800)
    go_part="$go_part (pace ${go_wk_pace}%)"
  fi
  go_part="$go_part month ${m_pct}%"
  go_mo_pace=
  if [ -n "$m_reset" ]; then
    go_mo_pace=$(pace $((m_reset / 1000)) 2592000)
    go_part="$go_part (pace ${go_mo_pace}%)"
  fi
  for w in "$r_pct $r_lim" "$w_pct $w_lim" "$m_pct $m_lim"; do
    pct=${w%% *}; lim=${w#* }
    if [ "$pct" -ge 80 ] || [ "$lim" = true ]; then go_tight=" go-tight"; fi
  done
  if [ -n "$go_wk_pace" ] && [ "$w_pct" -gt $((go_wk_pace + 10)) ]; then go_tight=" go-tight"; fi
  if [ -n "$go_mo_pace" ] && [ "$m_pct" -gt $((go_mo_pace + 10)) ]; then go_tight=" go-tight"; fi
fi

if [ -n "$sess" ] && [ -n "$week" ]; then
  s_used=${sess%% *}; s_pace=${sess#* }
  w_used=${week%% *}; w_pace=${week#* }
  claude_part="claude session ${s_used}% (pace ${s_pace}%) week ${w_used}% (pace ${w_pace}%)"
  if [ "$w_used" -gt $((w_pace + 10)) ] || [ "$s_used" -ge 80 ]; then
    advice=conserve
  elif [ "$w_used" -lt $((w_pace - 10)) ] && [ "$s_used" -lt 70 ]; then
    advice=open
  else
    advice=normal
  fi
else
  claude_part="claude unknown"
  advice=normal
fi

line="$claude_part | $go_part | advice: $advice$go_tight"
echo "$line"

mkdir -p "$(dirname "$LOG")" 2>/dev/null &&
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line" >> "$LOG" 2>/dev/null
exit 0
