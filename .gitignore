.DS_Store
**/.DS_Store

# SSH private keys and machine-specific data
home/.ssh/id_*
home/.ssh/authorized_keys
home/.ssh/known_hosts
home/.ssh/config.local
home/.ssh/control/

# Local shell settings
home/.zshrc.local
home/.zshenv.local

# OpenCode secrets and machine-local state
# (credentials auth.json live in ~/.local/share/opencode, outside this repo)
home/.config/opencode/auth.json
home/.config/opencode/service.json
home/.config/opencode/.env*
home/.config/opencode/node_modules/
